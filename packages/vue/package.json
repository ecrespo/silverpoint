{
  "name": "@silverpoint/vue",
  "version": "0.1.0",
  "description": "Vue 3 adapter of silverpoint: <script setup> components that translate core geometry into nodes.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@silverpoint/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./line-chart": {
      "@silverpoint/source": "./src/line-chart.ts",
      "types": "./dist/line-chart.d.ts",
      "import": "./dist/line-chart.js",
      "default": "./dist/line-chart.js"
    },
    "./bullet-chart": {
      "@silverpoint/source": "./src/bullet-chart.ts",
      "types": "./dist/bullet-chart.d.ts",
      "import": "./dist/bullet-chart.js",
      "default": "./dist/bullet-chart.js"
    },
    "./pyramid-chart": {
      "@silverpoint/source": "./src/pyramid-chart.ts",
      "types": "./dist/pyramid-chart.d.ts",
      "import": "./dist/pyramid-chart.js",
      "default": "./dist/pyramid-chart.js"
    },
    "./heatmap-chart": {
      "@silverpoint/source": "./src/heatmap-chart.ts",
      "types": "./dist/heatmap-chart.d.ts",
      "import": "./dist/heatmap-chart.js",
      "default": "./dist/heatmap-chart.js"
    },
    "./treemap-chart": {
      "@silverpoint/source": "./src/treemap-chart.ts",
      "types": "./dist/treemap-chart.d.ts",
      "import": "./dist/treemap-chart.js",
      "default": "./dist/treemap-chart.js"
    },
    "./sankey-chart": {
      "@silverpoint/source": "./src/sankey-chart.ts",
      "types": "./dist/sankey-chart.d.ts",
      "import": "./dist/sankey-chart.js",
      "default": "./dist/sankey-chart.js"
    },
    "./activity-grid": {
      "@silverpoint/source": "./src/activity-grid.ts",
      "types": "./dist/activity-grid.d.ts",
      "import": "./dist/activity-grid.js",
      "default": "./dist/activity-grid.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ecrespo/silverpoint.git",
    "directory": "packages/vue"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@silverpoint/core": "workspace:*",
    "@silverpoint/grounds": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.5",
    "tsup": "^8.5.1",
    "unplugin-vue": "^8.0.0",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  }
}
