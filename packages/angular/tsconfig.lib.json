{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": false,
    "inlineSources": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [],
    "experimentalDecorators": false,
    "verbatimModuleSyntax": false,
    "customConditions": []
  },
  "angularCompilerOptions": {
    "compilationMode": "partial",
    "strictTemplates": true,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "include": [
    "src/**/*.ts",
    "line-chart/**/*.ts",
    "bullet-chart/**/*.ts",
    "pyramid-chart/**/*.ts",
    "heatmap-chart/**/*.ts",
    "treemap-chart/**/*.ts",
    "sankey-chart/**/*.ts",
    "activity-grid/**/*.ts",
    "step-chart/**/*.ts",
    "sparkline-rows/**/*.ts",
    "kpi-card/**/*.ts",
    "bar-chart/**/*.ts",
    "stacked-bar-chart/**/*.ts",
    "composed-chart/**/*.ts",
    "waterfall-chart/**/*.ts",
    "funnel-chart/**/*.ts",
    "candlestick-chart/**/*.ts",
    "area-chart/**/*.ts",
    "range-band-chart/**/*.ts",
    "stream-chart/**/*.ts",
    "scatter-chart/**/*.ts",
    "bubble-chart/**/*.ts",
    "donut-chart/**/*.ts",
    "radar-chart/**/*.ts",
    "polar-bar-chart/**/*.ts",
    "radial-arc-group/**/*.ts",
    "radial-rings/**/*.ts",
    "gauge-arc/**/*.ts",
    "meter-chart/**/*.ts",
    "coxcomb-chart/**/*.ts",
    "wind-rose/**/*.ts",
    "volvelle-chart/**/*.ts",
    "chord-ring/**/*.ts",
    "orbit-chart/**/*.ts",
    "histogram-chart/**/*.ts",
    "ecdf-chart/**/*.ts",
    "box-plot-chart/**/*.ts",
    "violin-chart/**/*.ts",
    "ridgeline-chart/**/*.ts",
    "beeswarm-chart/**/*.ts",
    "lollipop-chart/**/*.ts",
    "dumbbell-chart/**/*.ts",
    "slope-chart/**/*.ts",
    "bump-chart/**/*.ts",
    "error-bar-chart/**/*.ts",
    "interval-chart/**/*.ts",
    "diverging-bar-chart/**/*.ts",
    "connected-scatter-chart/**/*.ts",
    "waffle-chart/**/*.ts",
    "marimekko-chart/**/*.ts",
    "squarified-treemap/**/*.ts",
    "sunburst-chart/**/*.ts",
    "tree-chart/**/*.ts",
    "parallel-coordinates-chart/**/*.ts",
    "polar-line-chart/**/*.ts",
    "polar-scatter-chart/**/*.ts",
    "density-bin-chart/**/*.ts",
    "contour-chart/**/*.ts",
    "delaunay-chart/**/*.ts",
    "vector-field-chart/**/*.ts",
    "network-chart/**/*.ts",
    "ui/**/*.ts",
    "env/**/*.ts"
  ],
  "exclude": [
    "**/*.spec.ts",
    "test/**"
  ]
}
