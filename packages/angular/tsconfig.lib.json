{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": false,
    "inlineSources": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [],
    "experimentalDecorators": false,
    "verbatimModuleSyntax": false,
    "customConditions": []
  },
  "angularCompilerOptions": {
    "compilationMode": "partial",
    "strictTemplates": true,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "include": [
    "src/**/*.ts",
    "line-chart/**/*.ts",
    "bullet-chart/**/*.ts",
    "pyramid-chart/**/*.ts",
    "heatmap-chart/**/*.ts",
    "treemap-chart/**/*.ts",
    "sankey-chart/**/*.ts",
    "activity-grid/**/*.ts",
    "step-chart/**/*.ts",
    "sparkline-rows/**/*.ts",
    "kpi-card/**/*.ts",
    "bar-chart/**/*.ts",
    "stacked-bar-chart/**/*.ts",
    "composed-chart/**/*.ts",
    "waterfall-chart/**/*.ts",
    "funnel-chart/**/*.ts",
    "candlestick-chart/**/*.ts",
    "area-chart/**/*.ts",
    "range-band-chart/**/*.ts",
    "stream-chart/**/*.ts",
    "scatter-chart/**/*.ts",
    "bubble-chart/**/*.ts"
  ],
  "exclude": [
    "**/*.spec.ts",
    "test/**"
  ]
}
