{
  "common": [
    {
      "name": "data",
      "type": "readonly Datum[]",
      "optional": true,
      "doc": "Rows to draw. If omitted, the demo dataset is rendered (REQ-093): accessor props (`…Key`, `keys`, `names`) are ignored, every other prop applies."
    },
    {
      "name": "ground",
      "type": "GroundRef",
      "optional": true,
      "doc": "Style ground. Defaults to the app provider's, or `silverpoint`."
    },
    {
      "name": "substrate",
      "type": "SubstrateName",
      "optional": true,
      "doc": "Prepared substrate within the ground (REQ-046)."
    },
    {
      "name": "mode",
      "type": "InkMode",
      "optional": true,
      "doc": "`ink` by default; `precision` disables inking (REQ-021)."
    },
    {
      "name": "seed",
      "type": "Seed",
      "optional": true,
      "doc": "Seed. If omitted, it is derived from `id` stably (REQ-003)."
    },
    {
      "name": "id",
      "type": "string",
      "optional": true,
      "doc": "Stable identifier. If omitted, it is generated deterministically."
    },
    {
      "name": "height",
      "type": "number",
      "optional": true,
      "doc": "Height of the drawing area in px. Width is the container's unless pinned."
    },
    {
      "name": "width",
      "type": "number",
      "optional": true,
      "doc": ""
    },
    {
      "name": "chrome",
      "type": "'card' | 'bare'",
      "optional": true,
      "doc": "`card` draws the full frame; `bare` only the drawing area (REQ-095)."
    },
    {
      "name": "hatchFill",
      "type": "'tile' | 'per-shape'",
      "optional": true,
      "doc": "How areas are filled (REQ-029)."
    },
    {
      "name": "title",
      "type": "string",
      "optional": true,
      "doc": ""
    },
    {
      "name": "badge",
      "type": "string",
      "optional": true,
      "doc": ""
    },
    {
      "name": "value",
      "type": "string | number",
      "optional": true,
      "doc": ""
    },
    {
      "name": "unit",
      "type": "string",
      "optional": true,
      "doc": ""
    },
    {
      "name": "footerLeft",
      "type": "string",
      "optional": true,
      "doc": ""
    },
    {
      "name": "footerRight",
      "type": "string",
      "optional": true,
      "doc": ""
    },
    {
      "name": "label",
      "type": "string",
      "optional": true,
      "doc": "Accessible name. If omitted, it is derived from `title` (REQ-120)."
    },
    {
      "name": "description",
      "type": "string",
      "optional": true,
      "doc": "Long description for screen readers (REQ-120)."
    },
    {
      "name": "dataTable",
      "type": "'visible' | 'hidden' | 'none'",
      "optional": true,
      "doc": "Tabular alternative; `hidden` leaves it for assistive technology only (REQ-121)."
