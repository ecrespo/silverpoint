{
  "name": "@silverpoint/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The documentation site: gallery, ground playground, quickstart and adapter parity (PRD \u00a75.1).",
  "scripts": {
    "generate": "tsx --conditions=@silverpoint/source scripts/generate.ts",
