{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @silverpoint/mcp... run build",
  "outputDirectory": "public",
  "functions": {
    "api/mcp.ts": { "maxDuration": 10, "memory": 1024 }
  },
  "rewrites": [{ "source": "/mcp", "destination": "/api/mcp" }],
  "redirects": [{ "source": "/", "destination": "https://silverpointweb.vercel.app/docs/ai", "permanent": false }]
}
