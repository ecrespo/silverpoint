    "fontkit": "^2.0.4",
    "nx": "^23.2.1",
    "parse5": "^8.0.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "size-limit": "^14.0.0",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
